name: Aggiorna Feed ManoMano Italy

on:
  schedule:
    - cron: '0 */8 * * *'   # Every 8 hours
  workflow_dispatch:

jobs:
  update-feed-it:
    runs-on: ubuntu-latest
    steps:
      - name: Scarica codice
        uses: actions/checkout@v3
        with:
          fetch-depth: 0

      - name: Wait for other workflows to complete
        uses: softprops/turnstyle@v1
        with:
          poll-interval-seconds: 10
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Setup Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.9'

      - name: Installa dipendenze
        run: pip install -r requirements.txt

      - name: Esegui sincronizzazione ManoMano Italy
        env:
          BIGBUY_API_KEY: ${{ secrets.BIGBUY_API_KEY }}
          COUNTRY_CODE: IT
        run: python bigbuy_manomano.py

      - name: Check generated files
        run: |
          echo "=== Files generated ==="
          ls -la *.csv *.html *.json 2>/dev/null || echo "No files found"
          echo "=== Italy-specific files ==="
          find . -name "manomano_feed_it.csv" -o -name "manomano_index_it.html" -o -name "manomano_info_it.json" 2>/dev/null || echo "No IT files found"
          if [ -f "manomano_feed_it.csv" ]; then
            wc -l manomano_feed_it.csv
            echo "✅ Found manomano_feed_it.csv with $(wc -l < manomano_feed_it.csv) lines"
          fi

      - name: Commit feed ManoMano IT
        run: |
          git config --local user.email "action@github.com"
          git config --local user.name "GitHub Action"

          git pull origin main --rebase || true

          files_to_add=""

          if [ -f "manomano_feed_it.csv" ]; then
            lines=$(wc -l < manomano_feed_it.csv)
            if [ "$lines" -gt 1 ]; then
              files_to_add="$files_to_add manomano_feed_it.csv"
              echo "✅ Will commit manomano_feed_it.csv with $lines lines"
            else
              echo "❌ manomano_feed_it.csv exists but is empty"
              exit 1
            fi
          else
            echo "❌ Missing manomano_feed_it.csv"
            exit 1
          fi

          if [ -f "manomano_index_it.html" ]; then
            files_to_add="$files_to_add manomano_index_it.html"
            echo "✅ Will commit manomano_index_it.html"
          fi

          if [ -f "manomano_info_it.json" ]; then
            files_to_add="$files_to_add manomano_info_it.json"
            echo "✅ Will commit manomano_info_it.json"
          fi

          if [ -n "$files_to_add" ]; then
            git add $files_to_add
            if git diff --cached --quiet; then
              echo "ℹ️ Nessuna modifica per ManoMano IT"
            else
              product_count=""
              fingerprint=""
              if [ -f "manomano_info_it.json" ]; then
                product_count=$(grep -o '"product_count": [0-9]*' manomano_info_it.json | grep -o '[0-9]*' | head -1)
                fingerprint=$(date +%s) # if you want a seed-like tag
              fi

              commit_msg="🇮🇹 Aggiorna ManoMano IT $(date '+%Y-%m-%d %H:%M')"
              [ -n "$product_count" ] && commit_msg="$commit_msg - ${product_count} prodotti"
              [ -n "$fingerprint" ] && commit_msg="$commit_msg [seed: $fingerprint]"

              for i in {1..3}; do
                echo "Tentativo $i/3 di commit e push..."
                if git commit -m "$commit_msg"; then
                  if git push; then
                    echo "✅ ManoMano IT aggiornato con successo!"
                    exit 0
                  else
                    echo "⚠️ Push fallito, tentativo $i/3"
                    if [ $i -lt 3 ]; then
                      git reset HEAD~1
                      git pull origin main --rebase || true
                      git add $files_to_add
                      sleep 5
                    fi
                  fi
                else
                  echo "❌ Commit fallito"
                  exit 1
                fi
              done

              echo "❌ Push fallito dopo 3 tentativi"
              exit 1
            fi
          else
            echo "❌ Nessun file IT generato - controllare il log Python"
            exit 1
          fi
